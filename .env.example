# Copy to .env and fill in. Keeps secrets out of code/history.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloud tier (Ollama Cloud — sign in with `ollama` to ollama.com first)
GC_CLOUD_MODEL=glm-5.2:cloud
GC_CLOUD_FALLBACK=kimi-k2.7-code:cloud

# Claude Code model for ask_cc() (default: claude-haiku-4-5-20251001)
GC_CC_MODEL=

# Local on-demand fallback (Ollama, default: qwen3:8b)
OLLAMA_MODEL=

# Email (optional)
EMAIL_IMAP_HOST=archbang.org
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=archbang.org
EMAIL_SMTP_PORT=465
EMAIL_ADDRESS=greenclaw@archbang.org
EMAIL_PASSWORD=
EMAIL_TRUSTED_SENDERS=you@example.com
# If set, an incoming email must contain this keyword to get full CC
# autonomy (shell, delegate_to_cc); without it, emails get the restricted
# cloud-model path. From: header spoofing isn't checked (no SPF/DKIM).
EMAIL_CC_KEYWORD=

# Dashboard (optional)
DASHBOARD_PORT=7070
DASHBOARD_HOST=127.0.0.1
DASHBOARD_TOKEN=
DASHBOARD_ENABLED=1   # set to 0 to skip starting the dashboard
GITHUB_TOKEN=
GITHUB_REPO=mrgreen3/greenclaw

# GitHub inbox watcher (optional) — fine-grained PAT scoped to this repo only
GREENCLAW_GH_TOKEN=

# Paper trading ETF tracker (optional)
# Get free API key from: https://www.alphavantage.co/api/
# (optional; free tier works without key at 5 calls/min, with key: 500/min)
ALPHA_VANTAGE_API_KEY=
